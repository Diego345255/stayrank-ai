HOTEL_API_KEY=your_api_key_here
HOTEL_API_HOST=booking-com15.p.rapidapi.com

# LLM_BASE_URL / LLM_MODEL default to OpenAI. To use DeepSeek instead, set:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-v4-flash   # check DeepSeek's current docs - their
#                                 # supported model names do change
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Hotelbeds Content API - a second, independent real-hotel-identity source
# (real names, photos, coordinates) used when Booking.com sync fails. Get a
# free Evaluation Plan key at developer.hotelbeds.com. See backend/hotelbeds.py.
HOTELBEDS_API_KEY=your_hotelbeds_api_key_here
HOTELBEDS_SECRET=your_hotelbeds_secret_here

# Real Stripe subscription billing for Trip Planner Pro (see backend/billing.py
# and backend/main.py's /api/billing/* endpoints). Optional - without this,
# Trip Planner Pro falls back to its original local-only "unlock" toggle that
# never charges anything.
#
# 1. Get your secret key from https://dashboard.stripe.com/apikeys
#    - sk_test_... for test mode (fake cards, no real money - start here)
#    - sk_live_... for live mode (real charges - only once you've verified
#      the whole flow works in test mode and your Stripe account is fully
#      set up for payouts)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
#
# 2. Optional but recommended for production: register a webhook endpoint
#    at https://dashboard.stripe.com/webhooks pointing to
#    <your-deployed-backend-url>/api/billing/webhook, listening for
#    checkout.session.completed, customer.subscription.updated, and
#    customer.subscription.deleted. Paste the signing secret it gives you
#    below. Not required for the basic subscribe/verify flow to work (that
#    happens synchronously right after checkout) - this only keeps access
#    in sync with a LATER cancellation or failed renewal. A local dev
#    sandbox has no public URL for Stripe to reach, so this is usually
#    left blank until you deploy somewhere with one.
STRIPE_WEBHOOK_SECRET=
#
# 3. Optional: also activate the Customer Portal once at
#    https://dashboard.stripe.com/settings/billing/portal so the "Manage
#    subscription" button works - Stripe returns a clear error if you skip
#    this and a subscriber tries to use it.
#
# Price in cents - defaults to 999 ($9.99/month) if unset.
STRIPE_PRO_PRICE_CENTS=999
